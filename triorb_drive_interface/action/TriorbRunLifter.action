# Execute the String command used by /drive/run_lifter and /collab/run_lifter.
# Allowed values: "stop", "up", "down", "middle".
string command
---
# True only when status is "success".
bool success
# Raw terminal value from the lifter result topic. Existing implementations
# publish "success", "failed", or an "error: ..." string.
string status
string message
---
# Raw state reported by the lifter bridge, for example "direction: up".
string state
string message
