# 有効期間内の単発音声を１回要求する。Clientは自動再試行しない。
AuxSoundOnce sound
---
uint8 ACCEPTED=0
uint8 ALREADY_ACCEPTED=1
uint8 INVALID_REQUEST=2
uint8 EXPIRED=3
uint8 NOT_CONNECTED=4
uint8 BUSY=5

# 新規queue投入、または同一session/event・内容を受付済みの場合true。
# trueはACCEPTED/ALREADY_ACCEPTEDのみ。その他のresult_codeではfalse。
# 機器の再生完了や、結果不明時も含めた厳密な１回再生を保証しない。
bool accepted false
uint8 result_code 2
# 人向けの理由。Clientの分岐条件には使わない。
string message
