triorb_aux_interface/AuxSoundOnce sound
---
uint8 ACCEPTED=0
uint8 ALREADY_ACCEPTED=1
uint8 INVALID_REQUEST=2
uint8 EXPIRED=3
uint8 NOT_CONNECTED=4
uint8 BUSY=5
# Acceptance or previous acceptance only; never indicates playback completion.
bool accepted
uint8 result_code
string message
