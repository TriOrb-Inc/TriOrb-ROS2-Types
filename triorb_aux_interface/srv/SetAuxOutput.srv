# 継続出力の完全なsnapshotを要求する。
AuxOutput output
---
uint8 ACCEPTED=0
uint8 ALREADY_ACCEPTED=1
uint8 INVALID_REQUEST=2
uint8 EXPIRED=3
uint8 NOT_CONNECTED=4
uint8 BUSY=5

# 最新出力として保存した時点でtrue。機器への反映完了を意味しない。
# accepted=trueはACCEPTEDのみ。その他のresult_codeではfalse。
# 切断中も有効な継続出力を受付可能。ALREADY_ACCEPTEDは単発音声用で本Serviceでは返さない。
bool accepted false
uint8 result_code 2
# 人向けの理由。Clientの分岐条件には使わない。
string message
