# AuxOutput/AuxSoundOnceのprimitive fieldで使う定数専用メッセージ。
# ROS上の意味を表す識別子。機器への送信値・音源番号への対応はbridgeが所有する。

uint8 LED_PATTERN_OFF=0
uint8 LED_PATTERN_ALL=1
uint8 LED_PATTERN_ALL_BLINK=2
uint8 LED_PATTERN_FORWARD=3
uint8 LED_PATTERN_RIGHT_FORWARD=4
uint8 LED_PATTERN_RIGHT=5
uint8 LED_PATTERN_RIGHT_BACK=6
uint8 LED_PATTERN_BACK=7
uint8 LED_PATTERN_LEFT_BACK=8
uint8 LED_PATTERN_LEFT=9
uint8 LED_PATTERN_LEFT_FORWARD=10
uint8 LED_PATTERN_CW=11
uint8 LED_PATTERN_CCW=12

uint8 LED_COLOR_WHITE=0
uint8 LED_COLOR_BLUE=1
uint8 LED_COLOR_GREEN=2
uint8 LED_COLOR_RED=3
uint8 LED_COLOR_MAGENTA=4
uint8 LED_COLOR_VIOLET=5
uint8 LED_COLOR_YELLOW=6
uint8 LED_COLOR_BLACK=7

uint8 LED_FLASH_SLOW=0
uint8 LED_FLASH_MEDIUM=1
uint8 LED_FLASH_FAST=2
uint8 LED_FLASH_VERY_FAST=3

# 継続出力はSTOP/LOOPのみ。単発再生はPlayAuxSoundOnceで要求する。
# 送信プロトコルのSTOP=2/LOOP=0とは異なるため、そのまま送信しない。
uint8 SPEAKER_MODE_STOP=0
uint8 SPEAKER_MODE_LOOP=1

# 音源番号ではない。STARTUP/FINISHの参照音源番号は13/14。
uint8 SOUND_CUE_NONE=0
uint8 SOUND_CUE_STARTUP=1
uint8 SOUND_CUE_START=2
uint8 SOUND_CUE_MELODY=3
uint8 SOUND_CUE_EMERGENCY=4
uint8 SOUND_CUE_ERROR=5
uint8 SOUND_CUE_LOST=6
uint8 SOUND_CUE_NAV_FAILED=7
uint8 SOUND_CUE_ECU_ERROR=8
uint8 SOUND_CUE_CHARGING=9
uint8 SOUND_CUE_FINISH=10
