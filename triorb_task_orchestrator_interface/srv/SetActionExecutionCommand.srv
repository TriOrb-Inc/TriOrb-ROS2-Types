# ActionExecution.actionに対する停止/一時停止/再開要求
# command
uint8 COMMAND_PAUSE=1
uint8 COMMAND_STOP=2
uint8 COMMAND_RESUME=3

uint8 CONTROL_CAUSE_TASK_COMMAND=1
uint8 CONTROL_CAUSE_PAUSE_RESTART=2
uint8 CONTROL_CAUSE_CONTROL_ACK_TIMEOUT=3

uint32 execution_id
uint32 action_control_request_id # execution内で非0・狭義単調増加。同一論理requestの通信再送時だけ同値
uint8 command
uint8 control_cause             # CONTROL_CAUSE_*。commandと組み合わせて意味を固定する
---
# result
uint32 execution_id              # request値を常にecho
uint32 action_control_request_id # request値を常にecho
bool success
uint32 response_reason_code # service受付結果。ActionExecutionReportDetail.REASON_*を使用し、report.reason_codeとは独立
bool report_valid           # reportが対象executionのsnapshotを持つ場合true
string message
ActionExecutionReport report
