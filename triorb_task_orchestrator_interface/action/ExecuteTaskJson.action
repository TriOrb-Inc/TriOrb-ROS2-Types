#== JSON 文字列で task を実行する action ==
uint32 loop                    # Must be greater than zero.
string json_task_data          # Json formatted Task data: Execution options are separate Goal fields.
float32 ratio_speed            # 速度倍率。vxy / vw に掛かる。0 以下は reject
float32 bias_accuracy_xy       # 位置の許容誤差に足すオフセット [m]
float32 bias_accuracy_deg      # 姿勢の許容誤差に足すオフセット [deg]
---
bool success
string final_status            # Finished / Error / Stopped / Canceled
string message                 # 失敗理由
---
TaskExecutionState state
