#==汎用：真偽値の設定（std_srvs/srv/SetBool の代わり）==
bool data       # 設定する値
---
bool success    # 成功したか
uint8 code      # 失敗の種類。triorb_common_interface/ErrorCode の定数（成功は OK）
string message  # 結果・失敗の理由
