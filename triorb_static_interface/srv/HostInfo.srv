#==[Service] Get host information (hostname / IP addresses)==
# GUI API: GET /network/host -> ROS 2 service /network/host/info
# The service server node calls triorb-system-cored GetHostInfo
# (gRPC over UDS, triorb.system.v1.HostInfoService) and relays the result.
std_msgs/Empty request
---
# Host name of this robot.
string hostname
# Representative IPv4 address used to reach this robot.
string primary_ip
# Network interfaces and their runtime configuration.
NetworkConnection[] interfaces
# True when the query completed successfully.
bool success
# Human-readable completion or error details.
string message
